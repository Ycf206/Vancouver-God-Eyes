# -------------------------------------------------------------
# 溫哥華上帝之眼 (Vancouver God's Eye) 環境設定範例
# -------------------------------------------------------------

# 後端 API 金鑰與配額設定
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_MAX_MONTHLY_CALLS=480

# 贊助金流設定 (Stripe / Buy Me a Coffee / PayPal)
# 1. 於 Stripe 後台 (https://dashboard.stripe.com/payment-links) 建立自訂金額 Payment Link 後填入：
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your_payment_link_here

# 2. 選填：其他贊助管道
NEXT_PUBLIC_BUYMEACOFFEE_URL=
NEXT_PUBLIC_PAYPAL_URL=
