# -------------------------------------------------------------
# 溫哥華上帝之眼 (Vancouver God's Eye) 環境設定範例
# -------------------------------------------------------------

# 後端 API 金鑰與配額設定
FLIGHTAWARE_API_KEY=
FLIGHTAWARE_MAX_MONTHLY_CALLS=480

# 贊助金流設定 (Stripe / Buy Me a Coffee / PayPal)
# 1. 於 Stripe 後台建立的自訂金額 Payment Link：
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://donate.stripe.com/6oU14g6Y7fgig6N1UfcMM00

# 2. 選填：其他贊助管道
NEXT_PUBLIC_BUYMEACOFFEE_URL=
NEXT_PUBLIC_PAYPAL_URL=
