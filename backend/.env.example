# Admin Security & Session Signing (Server-Side Only — NEVER expose as NEXT_PUBLIC_*)
# ADMIN_PASSWORD: Strong password required to log into https://admin.vangodseye.fyi/
# ADMIN_API_SECRET: Random 32+ byte secret used to sign HMAC-SHA256 admin session tokens
ADMIN_PASSWORD=
ADMIN_API_SECRET=

# Optional CORS & Database Pool Tuning
ALLOWED_ORIGINS=https://vangodseye.fyi,https://www.vangodseye.fyi,https://admin.vangodseye.fyi
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
ENABLE_API_DOCS=false
